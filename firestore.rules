rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur Louis (feste UID), rekursiv für alle Sammlungen und Untersammlungen.
    // Dieselbe UID steht in config.js und wrangler.toml, ein Test hält sie gleich.
    function isLouis() {
      return request.auth != null && request.auth.uid == "gH4Te1JZzaO7DVoTSg9TtK4gw8p1";
    }
    match /{document=**} {
      allow read, write: if isLouis();
    }
  }
}
