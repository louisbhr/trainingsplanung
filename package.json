{
  "name": "hm-tracker",
  "private": true,
  "type": "module",
  "description": "Halbmarathon-Tracker — statische Web-App, kein Build-Step. package.json existiert nur für die Tests.",
  "scripts": {
    "serve": "http-server -p 8099 -s .",
    "test:plan": "node tests/plan.test.mjs",
    "test:app": "node tests/app.test.mjs",
    "test": "node tests/plan.test.mjs && node tests/app.test.mjs"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "playwright": "^1.56.1"
  }
}
